# Local: matches docker-compose.yml by default
DATABASE_URL=postgresql+psycopg://recengine:recengine@localhost:5432/recengine

# JWT — generate a strong secret for production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

# CORS: comma-separated origins (no spaces). Next.js dev:
CORS_ORIGINS=http://localhost:3000
