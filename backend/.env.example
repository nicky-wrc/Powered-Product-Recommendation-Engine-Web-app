# Local: host port must match docker-compose.yml (e.g. 5433:5432 → use 5433 here)
DATABASE_URL=postgresql+psycopg://recengine:recengine@localhost:5433/recengine

# JWT — generate a strong secret for production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

# CORS_ORIGINS=comma-separated explicit hosts. With CORS_ALLOW_LAN_REGEX=true, loopback any port + [::1] + 192.168/10.* also match.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set false in production if you only serve the SPA from known hostnames.
CORS_ALLOW_LAN_REGEX=true

# Optional: recommendation cache (leave unset to disable). With docker-compose redis:
# REDIS_URL=redis://localhost:6379/0

# Optional admin bootstrap (runs on API startup when email + password are set). Development only — use strong secrets in production.
# BOOTSTRAP_ADMIN_EMAIL=nicky_admin@gmail.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me
# BOOTSTRAP_ADMIN_NAME=Nicky_Admin

# Optional: Stripe Checkout (test keys: https://dashboard.stripe.com/test/apikeys )
# STRIPE_SECRET_KEY=sk_test_...
# If you configure a webhook endpoint to /api/payments/webhook, set the signing secret (e.g. stripe listen).
# STRIPE_WEBHOOK_SECRET=whsec_...
# URL of the Next.js storefront for Stripe success/cancel redirects (default http://localhost:3000).
# PUBLIC_APP_URL=http://localhost:3000

# Loyalty (optional overrides): points earned per $1 of qualifying merchandise after discounts; points per $1 off at checkout.
# LOYALTY_EARN_POINTS_PER_DOLLAR=1
# LOYALTY_REDEEM_POINTS_PER_DOLLAR=100

# Cloudflare Turnstile (optional). When set, POST /api/auth/login and /register require cf_turnstile_response in JSON body.
# Create keys: https://dash.cloudflare.com/ → Turnstile. Frontend: NEXT_PUBLIC_TURNSTILE_SITE_KEY in frontend/.env.local
# TURNSTILE_SECRET_KEY=0x...

# Order confirmation email (optional). Without SMTP_HOST, the API logs the message at INFO for local dev.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# ORDER_EMAIL_FROM=orders@example.com

# PDF invoice branding (optional).
# STORE_INVOICE_NAME=NickyShopEngine
# INVOICE_LOGO_PATH=C:/path/to/logo.png
# Or place an image under backend/uploads/logo/ (first match is used).
# STORE_TAX_ID= (seller Tax ID on invoice)
# STORE_PHONE=
# STORE_INVOICE_ADDRESS= (multiline: use \n in .env, e.g. line1\nline2)